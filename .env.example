# Copy to .env (git-ignored) and replace the placeholders. Never commit .env.
# Read by docker-compose.yml (self-hosting, see docs/self-hosting.md) and docker-compose.dev.yml (development).

# --- Database (both compose files) ---
POSTGRES_USER=polymnia
POSTGRES_DB=polymnia
# Required. Use a long random value without ';', '"' or spaces, for example: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-locally

# --- Development only (docker-compose.dev.yml) ---
POSTGRES_PORT=5432
# The API does not read .env. Give it the connection string with user-secrets:
#   dotnet user-secrets set "ConnectionStrings:Polymnia" "Host=localhost;Port=5432;Database=polymnia;Username=polymnia;Password=<POSTGRES_PASSWORD>" --project api/Polymnia.Api
# or, in a deployment, with the environment variable:
#   ConnectionStrings__Polymnia=Host=...;Database=...;Username=...;Password=...

# --- Self-hosting (docker-compose.yml) ---
# Required. Host name(s) the app answers to, separated by ";". Example: polymnia.example.com
POLYMNIA_ALLOWED_HOSTS=polymnia.example.com
# Image and version. Pin an exact version (X.Y.Z) in production instead of "latest".
POLYMNIA_IMAGE=ghcr.io/sputier/polymnia
POLYMNIA_VERSION=latest
# Where the app listens on the host. Loopback by default: put a TLS reverse proxy in front.
POLYMNIA_BIND=127.0.0.1
POLYMNIA_PORT=8080
# Set to true when a reverse proxy terminates TLS in front of the app.
POLYMNIA_FORWARDED_HEADERS=false
# Subnet of the compose network (the only source trusted for forwarded headers). Change it on a clash.
POLYMNIA_SUBNET=172.31.250.0/24
# --- Google sign-in (docs/authentication.md) ---
# Self-hosting (docker-compose.yml): all three are required, Production refuses to start without them.
# Create the OAuth client as described in docs/authentication.md. Placeholders below are not valid.
POLYMNIA_PUBLIC_BASE_URL=https://polymnia.example.com
POLYMNIA_GOOGLE_CLIENT_ID=replace-with-your-client-id
POLYMNIA_GOOGLE_CLIENT_SECRET=replace-with-your-client-secret
# Development: the API does not read .env. Give it its settings with user-secrets:
#   dotnet user-secrets set "Auth:Google:ClientId" "<client id>" --project api/Polymnia.Api
#   dotnet user-secrets set "Auth:Google:ClientSecret" "<client secret>" --project api/Polymnia.Api
# In a deployment, use environment variables. Production refuses to start without them:
#   Auth__PublicBaseUrl=https://polymnia.example
#   Auth__Google__ClientId=<client id>
#   Auth__Google__ClientSecret=<client secret>
# Development defaults Auth:PublicBaseUrl to http://localhost:5173 (the Vite dev server).
