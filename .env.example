# Copy to .env (git-ignored) and replace the placeholders. Never commit .env.
# Read by docker-compose.yml (self-hosting, see docs/self-hosting.md) and docker-compose.dev.yml (development).

# --- Database (both compose files) ---
POSTGRES_USER=polymnia
POSTGRES_DB=polymnia
# Required. Use a long random value without ';', '"' or spaces, for example: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-locally

# --- Development only (docker-compose.dev.yml) ---
POSTGRES_PORT=5432
# The API does not read .env. Give it the connection string with user-secrets:
#   dotnet user-secrets set "ConnectionStrings:Polymnia" "Host=localhost;Port=5432;Database=polymnia;Username=polymnia;Password=<POSTGRES_PASSWORD>" --project api/Polymnia.Api
# or, in a deployment, with the environment variable:
#   ConnectionStrings__Polymnia=Host=...;Database=...;Username=...;Password=...

# --- Self-hosting (docker-compose.yml) ---
# Required. Host name(s) the app answers to, separated by ";". Example: polymnia.example.com
POLYMNIA_ALLOWED_HOSTS=polymnia.example.com
# Image and version. Pin an exact version (X.Y.Z) in production instead of "latest".
POLYMNIA_IMAGE=ghcr.io/sputier/polymnia
POLYMNIA_VERSION=latest
# Where the app listens on the host. Loopback by default: put a TLS reverse proxy in front.
POLYMNIA_BIND=127.0.0.1
POLYMNIA_PORT=8080
# Set to true when a reverse proxy terminates TLS in front of the app.
POLYMNIA_FORWARDED_HEADERS=false
# Subnet of the compose network (the only source trusted for forwarded headers). Change it on a clash.
POLYMNIA_SUBNET=172.31.250.0/24
# --- Google sign-in (docs/authentication.md) ---
# Self-hosting (docker-compose.yml): all three are required, Production refuses to start without them.
# Create the OAuth client as described in docs/authentication.md. Placeholders below are not valid.
POLYMNIA_PUBLIC_BASE_URL=https://polymnia.example.com
POLYMNIA_GOOGLE_CLIENT_ID=replace-with-your-client-id
POLYMNIA_GOOGLE_CLIENT_SECRET=replace-with-your-client-secret
# --- Privacy policy: who runs this instance (docs/privacy.md) ---
# The first three are required: Production refuses to start without them. They are shown, as they are, on the
# public privacy page (#/privacy): use details you are happy to publish. Placeholders below are not real.
POLYMNIA_LEGAL_OPERATOR_NAME=Example Operator
# Where people can exercise their rights (access, deletion, questions): "/#/contact" (the built-in contact form,
# below: no address is published), an e-mail address or an https URL.
POLYMNIA_LEGAL_CONTACT=/#/contact
# The company that hosts the server (a processor under GDPR).
POLYMNIA_LEGAL_HOSTING_PROVIDER=Example Hosting
# Optional. Postal address of the operator, and the country where the hosting provider stores the data.
POLYMNIA_LEGAL_ADDRESS=
POLYMNIA_LEGAL_HOSTING_COUNTRY=
# --- Contact form (docs/contact.md) ---
# Optional. To get the messages by e-mail, set the first three (all or none: a partial setup stops the start) and the
# SMTP login if your server asks for one. TLS is required: STARTTLS (port 587) or implicit TLS (port 465), never plain.
# Without them messages are only stored in the database and the app logs a warning at start-up.
# Your mailbox. It is never shown anywhere. Example (a placeholder, not real): operator@example.com
POLYMNIA_CONTACT_FORWARD_TO=
# The sender of the forwarded e-mails: an address your SMTP server lets you send as. Example: polymnia@example.com
POLYMNIA_CONTACT_FROM=
# Your SMTP server. Example: smtp.example.com
POLYMNIA_CONTACT_SMTP_HOST=
POLYMNIA_CONTACT_SMTP_PORT=587
# StartTls (port 587) or Implicit (port 465).
POLYMNIA_CONTACT_SMTP_SECURITY=StartTls
POLYMNIA_CONTACT_SMTP_USER=
# A secret: keep this file private. Empty together with the user when the server needs no login.
POLYMNIA_CONTACT_SMTP_PASSWORD=
# Days a message is kept (then deleted every hour). Quoted on the privacy page: keep it true.
POLYMNIA_CONTACT_RETENTION_DAYS=90
# Days you keep the application logs (they only hold internal user ids). Quoted on the privacy page: keep it true.
POLYMNIA_LOG_RETENTION_DAYS=30
# Required. Encrypts the Data Protection keys stored in the database. Create the file and pick the password
# with the openssl command in docs/authentication.md ("Encrypt the Data Protection keys").
POLYMNIA_KEYS_CERT_FILE=./secrets/polymnia-keys.pfx
# Text file holding the password of that .pfx (a Docker secret: not in the environment). Create it next to the .pfx.
POLYMNIA_KEYS_CERT_PASSWORD_FILE=./secrets/polymnia-keys.password
# Development: the API does not read .env. Give it its settings with user-secrets:
#   dotnet user-secrets set "Auth:Google:ClientId" "<client id>" --project api/Polymnia.Api
#   dotnet user-secrets set "Auth:Google:ClientSecret" "<client secret>" --project api/Polymnia.Api
# In a deployment, use environment variables. Production refuses to start without them:
#   Auth__PublicBaseUrl=https://polymnia.example
#   Auth__Google__ClientId=<client id>
#   Auth__Google__ClientSecret=<client secret>
# Development defaults Auth:PublicBaseUrl to http://localhost:5173 (the Vite dev server).
