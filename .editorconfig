root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[**/Migrations/*.cs]
generated_code = true

[api/Polymnia.Tests/**.cs]
# Test names use underscores for readability.
dotnet_diagnostic.CA1707.severity = none
