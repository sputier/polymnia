<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written test file: pickup measure, key change, dotted metronome mark, a triplet without
     tuplet marks, a time change, tempo given by a bare sound element, and clef changes (one at the
     end of the previous measure, as some programs write it). Melody: Oh! Susanna (public domain). -->
<score-partwise version="3.1">
  <part-list>
    <score-part id="P1"><part-name>Voice</part-name></score-part>
  </part-list>
  <part id="P1">
    <measure number="0" implicit="yes">
